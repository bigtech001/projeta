{
  "name": "@workspace/electron",
  "version": "0.0.0",
  "private": true,
  "description": "ChurchLive — Electron desktop wrapper",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_ENV=development electron dist/main.js",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.churchlive.app",
    "productName": "ChurchLive",
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": "../api-server/dist",
        "to": "api-server/dist",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
