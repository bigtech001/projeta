{
  "name": "@workspace/electron",
  "version": "1.0.0",
  "private": true,
  "description": "ChurchLive — Electron desktop wrapper",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_ENV=development electron dist/main.js",
    "pack": "pnpm run build && electron-builder --dir",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist": "pnpm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.churchlive.app",
    "productName": "ChurchLive",
    "extends": "./electron-builder.yml"
  }
}
